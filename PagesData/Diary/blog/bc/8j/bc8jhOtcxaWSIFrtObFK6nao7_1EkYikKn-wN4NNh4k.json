30fc\u30eb\u306f\u7ba1\u7406\u4eba\u3057\u304b\u898b\u306a\u3044\u904b\u7528\u306b\u3057\u305f\u3002\n\u30fb\u30ed\u30b0\u30a4\u30f3\u3067\u304d\u306a\u3044\u554f\u3044\u5408\u308f\u305b\u306b\u306f\u8fd4\u4fe1\u304c\u6765\u306a\u3044\u306e\u306b\u3001\u8ca9\u4fc3\u30e1\u30fc\u30eb\u306f\u5c4a\u304f\u3002\n\n\u2463 \u30ad\u30e3\u30c3\u30b7\u30e5\u30d0\u30c3\u30af\u3092\u53d7\u3051\u53d6\u308b\u307e\u3067\u304c\u96e3\u95a2\n\u30fb\u9ad8\u984d\u30ad\u30e3\u30c3\u30b7\u30e5\u30d0\u30c3\u30af\u3092\u5ba3\u4f1d\u3057\u3066\u3044\u308b\u304c\u3001\u53d7\u3051\u53d6\u308c\u308b\u306e\u306f\u5951\u7d04\u306e\u7d041\u5e74\u5f8c\u3002\n\u30fb\u666e\u6bb5\u4f7f\u308f\u306a\u3044GMO\u72ec\u81ea\u306e\u30e1\u30fc\u30eb\u30a2\u30c9\u30ec\u30b9\u306b\u6848\u5185\u304c\u5c4a\u304f\u3002\n\u30fb\u6307\u5b9a\u3055\u308c\u305f\u6642\u671f\u306b\u7533\u8acb\u3057\u306a\u3044\u3068\u53d7\u3051\u53d6\u308c\u306a\u3044\u3002\n\u30fb\u7fcc\u5e74\u30fb\u7fcc\u3005\u5e74\u306e2\u56de\u306b\u5206\u304b\u308c\u3001\u305d\u308c\u305e\u308c\u624b\u7d9a\u304d\u304c\u5fc5\u8981\u3060\u3063\u305f\u3068\u3044\u3046\u58f0\u3002\n\u30fb\u7533\u8acb\u65b9\u6cd5\u304c\u5206\u304b\u308a\u306b\u304f\u304f\u3001\u53d7\u3051\u53d6\u308c\u306a\u304b\u3063\u305f\u3068\u3044\u3046\u4f53\u9a13\u8ac7\u3002\n\u30fb\u300c\u5229\u7528\u8005\u304c\u5fd8\u308c\u308b\u3053\u3068\u3092\u671f\u5f85\u3057\u3066\u3044\u308b\u3088\u3046\u306b\u898b\u3048\u308b\u300d\u3068\u3044\u3046\u53cd\u611f\u3002\n\n\u2464 \u89e3\u7d04\u3057\u305f\u3044\u306e\u306b\u3001\u66f8\u985e\u304c\u6765\u306a\u3044\n\u30fb\u89e3\u7d04\u3067\u304d\u308b\u66f4\u65b0\u6708\u3084\u9023\u7d61\u671f\u9593\u304c\u9650\u3089\u308c\u3066\u3044\u305f\u3002\n\u30fb\u96fb\u8a71\u3057\u3066\u66f8\u985e\u3092\u53d6\u308a\u5bc4\u305b\u3001\u671f\u9650\u5fc5\u7740\u3067\u8fd4\u9001\u3059\u308b\u5fc5\u8981\u304c\u3042\u3063\u305f\u3002\n\u30fb\u305d\u306e\u96fb\u8a71\u304c\u3064\u306a\u304c\u3089\u306a\u3044\u3002\n\u30fb\u4f9d\u983c\u3057\u305f\u89e3\u7d04\u6