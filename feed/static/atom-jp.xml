&lt;p&gt;&lt;a target=&quot;_blank&quot; rel=&quot;noopener noreferrer&quot; href=&quot;/MyContents2026/2026-09-22/Z2h2JEr8-lm2_ud8/d3450d9789ab063a37fbfcb88f7693a1.jpg&quot;&gt;&lt;img src=&quot;/MyContents2026/2026-09-22/Z2h2JEr8-lm2_ud8/d3450d9789ab063a37fbfcb88f7693a1.jpg&quot; alt=&quot;&quot; title=&quot;七尾駅&quot; style=&quot;max-width: 100%;&quot;&gt;&lt;/a&gt;&lt;/p&gt;
